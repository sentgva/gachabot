# Эти же переменные задаются в Vercel: Project → Settings → Environment Variables

# Токен бота от @BotFather
BOT_TOKEN=

# Любая длинная случайная строка: защищает вебхук и страницу /api/setup (только для Vercel)
WEBHOOK_SECRET=

# Адрес Mini App (со слешем в конце): GitHub Pages или домен проекта на Vercel
WEBAPP_URL=https://sentgva.github.io/gachabot/

# Необязательно: ссылка на Mini App из BotFather (/newapp) — для кнопок в группах и инлайн-режиме
# MINIAPP_LINK=https://t.me/имя_бота/app

# Необязательно: Upstash Redis — чтобы на Vercel запоминался выбранный сервер (бесплатный тариф)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Необязательно: откуда брать данные (по умолчанию WEBAPP_URL + data/). local — только локальные файлы
# DATA_URL=local

# Как часто перечитывать данные с сайта, минут
# DATA_TTL_MIN=10
